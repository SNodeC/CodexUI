{
  "threadId": "lifecycle",
  "actions": {
    "seed": {"kind": "notification", "method": "thread/started", "payload": {"thread": {"id": "lifecycle", "status": {"type": "active"}, "turns": [{"id": "old", "status": "inProgress"}, {"id": "latest", "status": "inProgress"}]}}},
    "seed-empty-active": {"kind": "notification", "method": "thread/started", "payload": {"thread": {"id": "lifecycle", "status": {"type": "active"}, "turns": []}}},
    "seed-empty-idle": {"kind": "notification", "method": "thread/started", "payload": {"thread": {"id": "lifecycle", "status": {"type": "idle"}, "turns": []}}},
    "start": {"kind": "notification", "method": "turn/started", "payload": {"threadId": "lifecycle", "turn": {"id": "latest", "status": "inProgress"}}},
    "complete": {"kind": "notification", "method": "turn/completed", "payload": {"threadId": "lifecycle", "turn": {"id": "latest", "status": "completed"}}},
    "idle": {"kind": "notification", "method": "thread/status/changed", "payload": {"threadId": "lifecycle", "status": {"type": "idle"}}},
    "active": {"kind": "notification", "method": "thread/status/changed", "payload": {"threadId": "lifecycle", "status": {"type": "active"}}},
    "new": {"kind": "notification", "method": "turn/started", "payload": {"threadId": "lifecycle", "turn": {"id": "new", "status": "inProgress"}}},
    "final": {"kind": "notification", "method": "item/completed", "payload": {"threadId": "lifecycle", "turnId": "latest", "item": {"id": "answer", "type": "agentMessage", "phase": "final_answer", "text": "Done"}}},
    "resume": {"kind": "request", "method": "thread/resume", "id": "request", "payload": {"threadId": "lifecycle", "excludeTurns": true}},
    "resume-idle": {"kind": "response", "method": "thread/resume", "id": "request", "payload": {"thread": {"id": "lifecycle", "status": {"type": "idle"}, "turns": []}}},
    "resume-active": {"kind": "response", "method": "thread/resume", "id": "request", "payload": {"thread": {"id": "lifecycle", "status": {"type": "active"}, "turns": []}}},
    "resume-no-turns": {"kind": "response", "method": "thread/resume", "id": "request", "payload": {"thread": {"id": "lifecycle", "status": {"type": "idle"}}}},
    "page": {"kind": "request", "method": "thread/turns/list", "id": "request", "payload": {"threadId": "lifecycle", "sortDirection": "desc", "itemsView": "summary"}},
    "older-page": {"kind": "request", "method": "thread/turns/list", "id": "request", "payload": {"threadId": "lifecycle", "sortDirection": "desc", "itemsView": "summary", "cursor": "older"}},
    "completed-page": {"kind": "response", "method": "thread/turns/list", "id": "request", "payload": {"data": [{"id": "latest", "status": "completed"}, {"id": "old", "status": "inProgress"}], "nextCursor": null}},
    "stale-page": {"kind": "response", "method": "thread/turns/list", "id": "request", "payload": {"data": [{"id": "latest", "status": "inProgress"}, {"id": "old", "status": "inProgress"}], "nextCursor": null}},
    "older-completed": {"kind": "response", "method": "thread/turns/list", "id": "request", "payload": {"data": [{"id": "older", "status": "completed"}], "nextCursor": null}},
    "older-running": {"kind": "response", "method": "thread/turns/list", "id": "request", "payload": {"data": [{"id": "older", "status": "inProgress"}], "nextCursor": null}},
    "unfinished-only": {"kind": "response", "method": "thread/turns/list", "id": "request", "payload": {"data": [{"id": "old", "status": "inProgress"}], "nextCursor": null}},
    "read-other": {"kind": "request", "method": "thread/read", "id": "other", "payload": {"threadId": "lifecycle", "includeTurns": false}},
    "other-metadata": {"kind": "response", "method": "thread/read", "id": "other", "payload": {"thread": {"id": "lifecycle"}}}
  },
  "cases": [
    {"id": "overlap-complete-idle-resume-active", "steps": ["seed", "start", "resume", "complete", "idle", "resume-active"], "activeTurnId": null, "status": "idle"},
    {"id": "overlap-complete-resume-active-idle", "steps": ["seed", "start", "resume", "complete", "resume-active", "idle"], "activeTurnId": null, "status": "idle"},
    {"id": "overlap-idle-complete-resume-active", "steps": ["seed", "start", "resume", "idle", "complete", "resume-active"], "activeTurnId": null, "status": "idle"},
    {"id": "overlap-idle-resume-active-complete", "steps": ["seed", "start", "resume", "idle", "resume-active", "complete"], "activeTurnId": null, "status": "idle"},
    {"id": "overlap-resume-active-complete-idle", "steps": ["seed", "start", "resume", "resume-active", "complete", "idle"], "activeTurnId": null, "status": "idle"},
    {"id": "overlap-resume-active-idle-complete", "steps": ["seed", "start", "resume", "resume-active", "idle", "complete"], "activeTurnId": null, "status": "idle"},
    {"id": "sequential-resume", "steps": ["seed", "start", "complete", "idle", "resume", "resume-idle"], "activeTurnId": null, "status": "idle"},
    {"id": "sequential-page", "steps": ["seed", "start", "complete", "idle", "page", "completed-page"], "activeTurnId": null, "status": "idle"},
    {"id": "stale-page-after-completion", "steps": ["seed", "start", "page", "complete", "idle", "stale-page"], "activeTurnId": null, "status": "idle"},
    {"id": "first-loaded-page-in-idle-thread", "steps": ["seed-empty-idle", "page", "stale-page"], "activeTurnId": null, "status": "idle"},
    {"id": "new-live-during-resume", "steps": ["seed", "start", "complete", "idle", "resume", "new", "active", "resume-idle"], "activeTurnId": "new", "status": "active"},
    {"id": "new-live-before-thread-status", "steps": ["seed", "start", "complete", "idle", "resume", "new", "resume-idle"], "activeTurnId": "new"},
    {"id": "authoritative-idle-after-new-start", "steps": ["seed", "start", "new", "active", "resume", "resume-idle"], "activeTurnId": null, "status": "idle"},
    {"id": "metadata-without-turns-clears-current", "steps": ["seed", "start", "new", "active", "resume", "resume-no-turns"], "activeTurnId": null, "status": "idle"},
    {"id": "older-history-keeps-live-turn", "steps": ["seed", "start", "older-page", "older-completed"], "activeTurnId": "latest", "status": "active"},
    {"id": "older-history-cannot-reactivate", "steps": ["seed", "start", "complete", "idle", "older-page", "older-running"], "activeTurnId": null, "status": "idle"},
    {"id": "live-turn-during-page", "steps": ["seed", "start", "complete", "idle", "page", "new", "completed-page"], "activeTurnId": "new"},
    {"id": "cold-running-thread", "steps": ["seed-empty-active", "page", "stale-page"], "activeTurnId": "latest", "status": "active"},
    {"id": "idle-unfinished-only", "steps": ["seed-empty-idle", "page", "unfinished-only"], "activeTurnId": null, "status": "idle"},
    {"id": "same-turn-reactivated", "steps": ["seed", "start", "idle", "resume", "start", "resume-idle"], "activeTurnId": "latest", "status": "idle"},
    {"id": "unrelated-operation-not-live-evidence", "steps": ["seed", "start", "resume", "read-other", "other-metadata", "resume-idle"], "activeTurnId": null, "status": "idle"},
    {"id": "final-message-is-not-turn-completion", "steps": ["seed", "start", "final"], "activeTurnId": "latest", "status": "active"}
  ]
}
