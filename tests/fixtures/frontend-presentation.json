        {"value": "applyNetworkPolicyAmendment:0", "label": "Allow example.test in future", "tone": "approve", "requiresInput": false},
        {"value": "cancel", "label": "Cancel", "tone": "neutral", "requiresInput": false}
      ],
      "submissions": [
        {"id": "amend", "choice": "applyNetworkPolicyAmendment:0", "expected": {"result": {"decision": {"applyNetworkPolicyAmendment": {"network_policy_amendment": {"host": "example.test", "action": "allow"}}}}}}
      ]
    },
    {
