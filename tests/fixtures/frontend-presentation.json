  "pendingRequestCases": [
    {
      "id": "command-default",
      "method": "item/commandExecution/requestApproval",
      "raw": {"command": "git status"},
      "expectedKind": "command-approval",
      "expectedActions": [
        {"value": "accept", "label": "Accept", "tone": "approve", "requiresInput": false},
        {"value": "cancel", "label": "Cancel", "tone": "neutral", "requiresInput": false}
      ],
      "submissions": [
        {"id": "accept", "choice": "accept", "expected": {"result": {"decision": "accept"}}},
        {"id": "undeclared-decline", "choice": "decline", "expected": null}
      ]
    },
    {
      "id": "command-declared-structured-exec",
      "method": "item/commandExecution/requestApproval",
      "raw": {
        "command": "git status",
        "proposedExecpolicyAmendment": ["git", "status"],
        "availableDecisions": [
          "cancel",
          {"acceptWithExecpolicyAmendment": {"execpolicy_amendment": ["git", "status"]}}
        ]
      },
      "expectedKind": "command-approval",
      "expectedActions": [
        {"value": "cancel", "label": "Cancel", "tone": "neutral", "requiresInput": false},
        {"value": "acceptWithExecpolicyAmendment:1", "label": "Accept and allow matching commands: git", "tone": "approve", "requiresInput": false}
      ],
      "submissions": [
        {"id": "amend", "choice": "acceptWithExecpolicyAmendment:1", "expected": {"result": {"decision": {"acceptWithExecpolicyAmendment": {"execpolicy_amendment": ["git", "status"]}}}}},
        {"id": "undeclared-accept", "choice": "accept", "expected": null}
      ]
    },
    {
      "id": "command-exec-fallback",
      "method": "item/commandExecution/requestApproval",
      "raw": {"command": "git status", "proposedExecpolicyAmendment": ["git", "status"]},
      "expectedKind": "command-approval",
      "expectedActions": [
        {"value": "accept", "label": "Accept", "tone": "approve", "requiresInput": false},
        {"value": "acceptWithExecpolicyAmendment:0", "label": "Accept and allow matching commands: git", "tone": "approve", "requiresInput": false},
        {"value": "cancel", "label": "Cancel", "tone": "neutral", "requiresInput": false}
      ],
      "submissions": [
        {"id": "amend", "choice": "acceptWithExecpolicyAmendment:0", "expected": {"result": {"decision": {"acceptWithExecpolicyAmendment": {"execpolicy_amendment": ["git", "status"]}}}}}
      ]
    },
